[submodule "linux"]
	path = linux
	url = https://github.com/osqzss/linux.git
	branch = crpa
[submodule "hdl"]
	path = hdl
	url = https://github.com/osqzss/hdl.git
	branch = crpa
[submodule "br2-external"]
	path = br2-external
	url = https://github.com/analogdevicesinc/br2-external.git
	branch = main
	ignore = untracked
[submodule "u-boot"]
	path = u-boot
	url = https://github.com/analogdevicesinc/u-boot.git
	branch = adi-xlnx-u-boot-2025.1-y
[submodule "buildroot"]
	path = buildroot
	url = https://github.com/analogdevicesinc/buildroot.git
	branch = adi-2026.02-y
